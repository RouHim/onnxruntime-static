# Cross toolchain from messense/rust-musl-cross. The image exports
# TARGET_CC/TARGET_CXX/TARGET_AR/TARGET_RANLIB/TARGET_HOME.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_C_COMPILER "$ENV{TARGET_CC}")
set(CMAKE_CXX_COMPILER "$ENV{TARGET_CXX}")
set(CMAKE_AR "$ENV{TARGET_AR}")
set(CMAKE_RANLIB "$ENV{TARGET_RANLIB}")
set(CMAKE_FIND_ROOT_PATH "$ENV{TARGET_HOME}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
